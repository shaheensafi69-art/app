// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  firstName            String?
  lastName             String?
  password             String?
  stripeAccountId      String?  @unique // Custom Connect Account ID
  financialAccountId   String?  @unique // Treasury Financial Account ID
  cardholderId         String?  @unique // Issuing Cardholder ID
  verificationStatus   String   @default("pending") // pending, verified, rejected
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  cards                Card[]
  transactions         Transaction[]
}

model Card {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  stripeCardId         String   @unique // Stripe Issuing Card ID
  last4                String?
  expMonth             Int?
  expYear              Int?
  status               String   @default("active") // active, inactive, canceled
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  stripeTxId      String?  @unique
  amount          Float
  currency        String   @default("usd")
  status          String   @default("completed") // pending, completed, failed
  type            String   // deposit, withdrawal, transfer, card_payment
  vendorName      String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CurrencyRate {
  id           String   @id @default(uuid())
  symbol       String   @unique // USD, EUR, GBP
  rate         Float    // Relative to base (USD)
  change       Float    // Daily change percentage (e.g. +0.4)
  symbolChar   String   // $, €, £
  updatedAt    DateTime @default(now())
}
